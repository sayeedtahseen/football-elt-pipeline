LOG_LEVEL=INFO

# Key from dashboard.api-football.com (API-Sports direct).
API_FOOTBALL_KEY=your-api-sports-key-here
API_FOOTBALL_HOST=v3.football.api-sports.io
# Free plan: 100 requests/day, 10/minute. Set headroom under whatever your
# plan's actual per-minute limit is -- confirm with GET /status.
API_RATE_LIMIT_RPM=8


GCP_PROJECT=football-elt-xxxxx
BQ_LOCATION=US
BQ_RAW_DATASET=football_raw
GOOGLE_APPLICATION_CREDENTIALS=./secrets/sa.json

DBT_PROFILES_DIR=./dbt/football
DBT_TARGET=dev

LEAGUES=39,140,135,78,61
SEASONS=2024,2025

# daily-mode fixtures window: today - lookback .. today + lookahead
DAILY_LOOKBACK_DAYS=3
DAILY_LOOKAHEAD_DAYS=7